# Copier en .env.local si besoin. Ne jamais y mettre de secret : ce fichier est lu par le navigateur.

# Adresse de l'API. Vide = même adresse que le site (le proxy de Vite transmet /api).
# En production : l'adresse complète de l'API, par exemple https://api.exemple.cm
VITE_API_URL=

# Cible du proxy de Vite en développement (npm run dev). Par défaut : l'API locale.
VITE_API_PROXY_TARGET=http://localhost:5122
